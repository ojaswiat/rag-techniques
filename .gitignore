# graphify: local interpreter path, machine-specific. Graph outputs stay tracked.
graphify-out/.graphify_python

# graphify: dated pre-rebuild snapshots of the graph. Local safety net only,
# one per `graphify update` run and up to 18MB each. Already-tracked snapshots
# are unaffected. The live graph in graphify-out/ stays tracked.
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
*.mov