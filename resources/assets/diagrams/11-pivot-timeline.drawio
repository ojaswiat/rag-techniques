        <mxCell id="c18" value="Structural metadata found leaking into P1&#x27;s embedded text — would have handed the vector arm an unfair advantage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="650" y="490" width="280" height="130" as="geometry"/></mxCell>
