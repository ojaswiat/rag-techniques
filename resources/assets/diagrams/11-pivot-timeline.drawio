<mxfile host="app.diagrams.net" type="device">
  <diagram id="11-pivot-timeline.drawio" name="Decision and Pivot Timeline">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Decisions, Pivots and the Bugs That Forced Them" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#d946ef;fontSize=24;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="44" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="t2" value="27 deviations are documented rather than absorbed. Several are findings in themselves." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="1200" height="22" as="geometry"/></mxCell>
        <mxCell id="l3" style="endArrow=none;html=1;strokeColor=#64748b;strokeWidth=2;shadow=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="420" as="sourcePoint"/><mxPoint x="1490" y="420" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="211" y="411" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="c5" value="21 JUL   ·   MODEL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="220" width="280" height="34" as="geometry"/></mxCell>
        <mxCell id="c6" value="Groq stopped hosting qwen3-32b: every Critic and Judge route returned 404. Swapped both to qwen3.6-27b, the closest model on the account, so family separation held." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="80" y="254" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="l7" style="endArrow=none;html=1;strokeColor=#8b5cf6;strokeWidth=2;shadow=0;dashed=1;dashPattern=3 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="384" as="sourcePoint"/><mxPoint x="220" y="420" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="401" y="411" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="c9" value="29 JUL   ·   MODEL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="456" width="280" height="34" as="geometry"/></mxCell>
        <mxCell id="c10" value="llama-3.1-8b produced unreliable summaries on dense filing sections. Moved to gpt-oss-20b; Llama 70B and Qwen 27B were rejected because each already holds another role." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="270" y="490" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="l11" style="endArrow=none;html=1;strokeColor=#8b5cf6;strokeWidth=2;shadow=0;dashed=1;dashPattern=3 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="420" as="sourcePoint"/><mxPoint x="410" y="456" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c12" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6366f1;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="591" y="411" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="c13" value="31 JUL   ·   PROVIDER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6366f1;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="220" width="280" height="34" as="geometry"/></mxCell>
        <mxCell id="c14" value="Groq&#39;s daily free-tier limit ran out before any P3 build could finish. NVIDIA NIM added as a second provider so the tree build has quota outside Groq&#39;s ceiling." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6366f1;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="460" y="254" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="l15" style="endArrow=none;html=1;strokeColor=#6366f1;strokeWidth=2;shadow=0;dashed=1;dashPattern=3 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="384" as="sourcePoint"/><mxPoint x="600" y="420" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c16" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="781" y="411" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="c17" value="10 AUG   ·   METHODOLOGY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="456" width="280" height="34" as="geometry"/></mxCell>
        <mxCell id="c18" value="Structural metadata found leaking into P1&#x27;s embedded text, which would have handed the vector arm an unfair advantage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="650" y="490" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="l19" style="endArrow=none;html=1;strokeColor=#ef4444;strokeWidth=2;shadow=0;dashed=1;dashPattern=3 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="420" as="sourcePoint"/><mxPoint x="790" y="456" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c20" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f59e0b;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="971" y="411" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="c21" value="11 AUG   ·   SCOPE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f59e0b;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="840" y="220" width="280" height="34" as="geometry"/></mxCell>
        <mxCell id="c22" value="JPM and JNJ added for their denser tables and footnotes. A hardcoded 9-filing list meant the orchestrator silently skipped all four new filings." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f59e0b;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="840" y="254" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="l23" style="endArrow=none;html=1;strokeColor=#f59e0b;strokeWidth=2;shadow=0;dashed=1;dashPattern=3 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980" y="384" as="sourcePoint"/><mxPoint x="980" y="420" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c24" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6366f1;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="1161" y="411" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="c25" value="12 AUG   ·   PROVIDER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6366f1;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1030" y="456" width="280" height="34" as="geometry"/></mxCell>
        <mxCell id="c26" value="Groq caps the Generator at ~8K tokens per minute, so any large section failed with 413 on every retry. Moved to NIM, then OpenRouter with a disclosed $10 top-up." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6366f1;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="1030" y="490" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="l27" style="endArrow=none;html=1;strokeColor=#6366f1;strokeWidth=2;shadow=0;dashed=1;dashPattern=3 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="420" as="sourcePoint"/><mxPoint x="1170" y="456" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c28" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="1351" y="411" width="18" height="18" as="geometry"/></mxCell>
        <mxCell id="c29" value="12 AUG   ·   ARCHITECTURE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="220" width="280" height="34" as="geometry"/></mxCell>
        <mxCell id="c30" value="SummaryIndex has no real traversal, so the structural arm would have been a flat scan. TreeIndex gives a genuine root-to-leaf retriever with no query-time LLM call." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="1220" y="254" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="l31" style="endArrow=none;html=1;strokeColor=#8b5cf6;strokeWidth=2;shadow=0;dashed=1;dashPattern=3 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1360" y="384" as="sourcePoint"/><mxPoint x="1360" y="420" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t32" value="WHY THESE ARE PUBLISHED RATHER THAN FIXED WITHOUT COMMENT" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="680" width="1400" height="24" as="geometry"/></mxCell>
        <mxCell id="c33" value="&quot;A three-provider fallback chain was necessary to run a 900-cell LLM benchmark on free tiers&quot; is a reproducibility result about the infrastructure available to an unfunded researcher. It belongs in the dissertation, not in a git history." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=18;spacingRight=18;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="80" y="716" width="690" height="110" as="geometry"/></mxCell>
        <mxCell id="c34" value="The P1 metadata leak shows that fairness in a controlled retrieval comparison has to be enforced in code. It failed silently until review caught it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=18;spacingRight=18;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="800" y="716" width="680" height="110" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
