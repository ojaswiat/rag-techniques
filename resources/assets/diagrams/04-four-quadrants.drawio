<mxfile host="app.diagrams.net" type="device">
  <diagram id="04-four-quadrants.drawio" name="Four Difficulty Quadrants">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Four Difficulty Quadrants" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#f59e0b;fontSize=24;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="44" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="t2" value="25 questions per cell. Balanced by difficulty, not by company, so no arm wins on sampling." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="1200" height="22" as="geometry"/></mxCell>
        <mxCell id="t3" value="TEXT-HEAVY CONTEXT" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#64748b;fontSize=14;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="150" width="440" height="30" as="geometry"/></mxCell>
        <mxCell id="t4" value="TABLE-HEAVY CONTEXT" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#64748b;fontSize=14;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="440" height="30" as="geometry"/></mxCell>
        <mxCell id="t5" value="EXPLICIT  ·  stated verbatim" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#64748b;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;horizontal=0;" vertex="1" parent="1"><mxGeometry x="190" y="200" width="40" height="320" as="geometry"/></mxCell>
        <mxCell id="t6" value="IMPLICIT  ·  must be inferred" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#64748b;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;horizontal=0;" vertex="1" parent="1"><mxGeometry x="190" y="560" width="40" height="320" as="geometry"/></mxCell>
        <mxCell id="c7" value="DIRECT-TEXT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#84cc16;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="200" width="440" height="52" as="geometry"/></mxCell>
        <mxCell id="c8" value="25  questions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#84cc16;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="252" width="440" height="60" as="geometry"/></mxCell>
        <mxCell id="c9" value="The answer appears as a sentence in the filing.&#xa;Both semantic and statistical retrieval should&#xa;succeed — the control cell." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#84cc16;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="320" y="312" width="440" height="116" as="geometry"/></mxCell>
        <mxCell id="c10" value="&quot;Who is the company&#x27;s auditor?&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#84cc16;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="320" y="428" width="440" height="52" as="geometry"/></mxCell>
        <mxCell id="c11" value="DIRECT-TABLE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f59e0b;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="200" width="440" height="52" as="geometry"/></mxCell>
        <mxCell id="c12" value="25  questions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f59e0b;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="252" width="440" height="60" as="geometry"/></mxCell>
        <mxCell id="c13" value="The answer is one cell in a financial table.&#xa;Expected to favour exact-token matching and to&#xa;expose the structural arm&#x27;s summarisation loss." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f59e0b;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="800" y="312" width="440" height="116" as="geometry"/></mxCell>
        <mxCell id="c14" value="&quot;What was total revenue in FY2024?&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f59e0b;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="800" y="428" width="440" height="52" as="geometry"/></mxCell>
        <mxCell id="c15" value="IMPLICIT-TEXT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#14b8a6;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="560" width="440" height="52" as="geometry"/></mxCell>
        <mxCell id="c16" value="25  questions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#14b8a6;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="612" width="440" height="60" as="geometry"/></mxCell>
        <mxCell id="c17" value="The answer is paraphrased or spread across&#xa;paragraphs. Expected to favour meaning-based&#xa;retrieval over literal term overlap." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#14b8a6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="320" y="672" width="440" height="116" as="geometry"/></mxCell>
        <mxCell id="c18" value="&quot;What risk does management stress most?&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#14b8a6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="320" y="788" width="440" height="52" as="geometry"/></mxCell>
        <mxCell id="c19" value="IMPLICIT-TABLE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f43f5e;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="560" width="440" height="52" as="geometry"/></mxCell>
        <mxCell id="c20" value="25  questions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f43f5e;strokeColor=none;fontColor=#FFFFFF;fontSize=22;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="612" width="440" height="60" as="geometry"/></mxCell>
        <mxCell id="c21" value="Requires reading a table and reasoning over it.&#xa;The hardest cell — expected to be where all&#xa;three paradigms degrade." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f43f5e;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="800" y="672" width="440" height="116" as="geometry"/></mxCell>
        <mxCell id="c22" value="&quot;By how much did margin move year on year?&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f43f5e;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="800" y="788" width="440" height="52" as="geometry"/></mxCell>
        <mxCell id="t23" value="Every stated expectation is a HYPOTHESIS. The benchmark exists to falsify it, not to confirm it." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#ef4444;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="910" width="1200" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
