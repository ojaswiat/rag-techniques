        <mxCell id="c32" value="Every US filer submits the same numbered form — questions transfer across companies and years" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="760" y="610" width="600" height="58" as="geometry"/></mxCell>
        <mxCell id="c33" value="Audited tables sit beside narrative prose — the exact case that separates the paradigms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#14b8a6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="760" y="684" width="600" height="58" as="geometry"/></mxCell>
        <mxCell id="c34" value="Figures are legally binding, so ground truth is verifiable, not a matter of opinion" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#06b6d4;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="760" y="758" width="600" height="58" as="geometry"/></mxCell>
        <mxCell id="c35" value="EDGAR is public and licence-clean — required for a $0, reproducible study" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0ea5e9;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="760" y="832" width="600" height="58" as="geometry"/></mxCell>
        <mxCell id="c36" value="KNOWN, DOCUMENTED PARSING DEFECT — LlamaParse merged a units caption into the column-one header on 31 tables.&#xa;Left unfixed by design: it degrades all three pipelines identically, so it shifts absolute scores but not the comparison." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=18;spacingRight=18;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="80" y="900" width="1280" height="72" as="geometry"/></mxCell>
