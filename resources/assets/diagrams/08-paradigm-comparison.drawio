        <mxCell id="c10" value="Dense float vectors capturing the meaning of each chunk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0ea5e9;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=top;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="320" y="270" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c11" value="A sparse term-frequency table over literal tokens" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=top;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="680" y="270" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="c12" value="A hierarchy of LLM-written summaries sitting above the raw nodes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=top;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="1040" y="270" width="320" height="84" as="geometry"/></mxCell>
        <mxCell id="t13" value="WHAT IT MATCHES ON" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#64748b;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="384" width="250" height="88" as="geometry"/></mxCell>
        <mxCell id="c14" value="Cosine proximity in embedding space, then cross-encoder rerank" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0ea5e9;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=top;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="320" y="384" width="320" height="88" as="geometry"/></mxCell>
        <mxCell id="c15" value="Term overlap weighted by rarity and document length" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=top;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="680" y="384" width="320" height="88" as="geometry"/></mxCell>
        <mxCell id="c16" value="Top-down traversal: picks a branch by summary relevance, does not scan all leaves" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=top;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="1040" y="384" width="320" height="88" as="geometry"/></mxCell>
        <mxCell id="t17" value="WHERE IT IS EXPECTED TO BREAK" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#64748b;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="502" width="250" height="96" as="geometry"/></mxCell>
        <mxCell id="c18" value="Near-identical phrasing across fiscal years: &quot;revenue increased&quot; reads the same in FY23 and FY24" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0ea5e9;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=top;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="320" y="502" width="320" height="96" as="geometry"/></mxCell>
        <mxCell id="c19" value="Paraphrase and inference, where the answer shares no token with the question" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=top;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="680" y="502" width="320" height="96" as="geometry"/></mxCell>
        <mxCell id="c20" value="Tables: summarisation flattens a numeric grid into prose and the specific cell stops being retrievable" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=top;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="1040" y="502" width="320" height="96" as="geometry"/></mxCell>
        <mxCell id="c21" value="WHAT THIS TABLE CLAIMS: the first two rows are facts about the implementation. The third row is a prediction.&#xa;If all three arms score within noise, the finding is that paradigm choice is not the dominant factor, and that result stands." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=18;spacingRight=18;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="80" y="650" width="1280" height="76" as="geometry"/></mxCell>
