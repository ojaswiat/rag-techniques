        <mxCell id="c32" value="Retrieval depth interacts with paradigm. BM25 may be sharply precise at K=3 and gain nothing from K=10, while the vector arm may need depth before recall becomes usable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6366f1;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="760" y="802" width="600" height="78" as="geometry"/></mxCell>
