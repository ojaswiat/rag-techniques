        <mxCell id="t27" value="FIVE LAYERS BETWEEN THE CODE AND THE QUOTA" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="1340" height="24" as="geometry"/></mxCell>
        <mxCell id="c28" value="1  ABSTRACTION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0ea5e9;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="736" width="300" height="48" as="geometry"/></mxCell>
        <mxCell id="c29" value="LLMFactory resolves a stage to a client, so re-routing is a config change, not a rewrite" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0ea5e9;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=18;spacingRight=18;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="390" y="736" width="1030" height="48" as="geometry"/></mxCell>
        <mxCell id="c30" value="2  RATE LIMIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#06b6d4;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="794" width="300" height="48" as="geometry"/></mxCell>
        <mxCell id="c31" value="per-client RPM throttle matched to each provider&#x27;s published ceiling" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#06b6d4;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=18;spacingRight=18;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="390" y="794" width="1030" height="48" as="geometry"/></mxCell>
        <mxCell id="c32" value="3  CONCURRENCY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#14b8a6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="852" width="300" height="48" as="geometry"/></mxCell>
        <mxCell id="c33" value="GROQ / NIM / OPENROUTER _MAX_CONCURRENCY = 5 — a separate axis from RPM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#14b8a6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=18;spacingRight=18;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="390" y="852" width="1030" height="48" as="geometry"/></mxCell>
        <mxCell id="c34" value="4  RETRY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="910" width="300" height="48" as="geometry"/></mxCell>
        <mxCell id="c35" value="exponential backoff on the provider&#x27;s own exception classes, not a generic catch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=18;spacingRight=18;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="390" y="910" width="1030" height="48" as="geometry"/></mxCell>
        <mxCell id="c36" value="5  RESUMABILITY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#22c55e;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="968" width="300" height="48" as="geometry"/></mxCell>
        <mxCell id="c37" value="hit the cap, stop, resume tomorrow — the UNIQUE key guarantees nothing is lost or repeated" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#22c55e;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=18;spacingRight=18;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="390" y="968" width="1030" height="48" as="geometry"/></mxCell>
        <mxCell id="t38" value="THE BINDING CONSTRAINT IS TOKENS-PER-DAY, NOT REQUESTS-PER-MINUTE — the Answerer&#x27;s ~100K TPD ceiling is what sets the multi-week timeline." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#ef4444;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="1026" width="1340" height="26" as="geometry"/></mxCell>
