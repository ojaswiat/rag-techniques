        <mxCell id="t1" value="Evaluation — Gate First, Then the Full Run" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#a855f7;fontSize=24;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="44" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="t2" value="The judge is validated as a measuring instrument before it is allowed to grade anything that counts." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="1200" height="22" as="geometry"/></mxCell>
        <mxCell id="t3" value="PHASE A  ·  JUDGE VALIDATION GATE  ·  cheap, runs first" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#ec4899;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="640" height="26" as="geometry"/></mxCell>
        <mxCell id="c4" value="JEQ  ·  20 questions held out for this purpose only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ec4899;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="178" width="640" height="64" as="geometry"/></mxCell>
        <mxCell id="c5" value="run through all three pipelines  →  60 outputs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6366f1;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="266" width="640" height="64" as="geometry"/></mxCell>
        <mxCell id="c6" value="human scores" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#06b6d4;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="354" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="c7" value="judge scores" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a855f7;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="354" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="c8" value="agreement  &gt;  80 %  ?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="442" width="640" height="64" as="geometry"/></mxCell>
        <mxCell id="c9" value="PASS  →  Phase B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#22c55e;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="530" width="300" height="64" as="geometry"/></mxCell>
        <mxCell id="c10" value="FAIL  →  recalibrate on GQ, re-test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f97316;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="530" width="300" height="64" as="geometry"/></mxCell>
