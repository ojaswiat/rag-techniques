        <mxCell id="t18" value="PHASE B  ·  FULL BENCHMARK  ·  expensive, gated" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#3b82f6;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="140" width="560" height="26" as="geometry"/></mxCell>
        <mxCell id="c19" value="PQ  ·  100 questions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3b82f6;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="178" width="560" height="64" as="geometry"/></mxCell>
        <mxCell id="c20" value="× 3 pipelines  ×  K = 3, 5, 10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6366f1;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="266" width="560" height="64" as="geometry"/></mxCell>
        <mxCell id="c21" value="900 result rows, written resumably" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f59e0b;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="354" width="560" height="64" as="geometry"/></mxCell>
        <mxCell id="c22" value="judge scores every row" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a855f7;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="442" width="560" height="64" as="geometry"/></mxCell>
        <mxCell id="c23" value="per-quadrant comparison" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#06b6d4;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="530" width="560" height="64" as="geometry"/></mxCell>
        <mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3b82f6;strokeWidth=2;endArrow=block;endFill=1;shadow=0;fontColor=#3b82f6;fontSize=11;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;labelBackgroundColor=none;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6366f1;strokeWidth=2;endArrow=block;endFill=1;shadow=0;fontColor=#6366f1;fontSize=11;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;labelBackgroundColor=none;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#f59e0b;strokeWidth=2;endArrow=block;endFill=1;shadow=0;fontColor=#f59e0b;fontSize=11;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;labelBackgroundColor=none;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#a855f7;strokeWidth=2;endArrow=block;endFill=1;shadow=0;fontColor=#a855f7;fontSize=11;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;labelBackgroundColor=none;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t28" value="the gate must clear before Phase B is allowed to start   →" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontColor=#22c55e;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="606" width="640" height="24" as="geometry"/></mxCell>
        <mxCell id="t29" value="THREE PILLARS OF MEASUREMENT" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="650" width="1280" height="26" as="geometry"/></mxCell>
        <mxCell id="c30" value="RETRIEVAL QUALITY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#06b6d4;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="688" width="400" height="48" as="geometry"/></mxCell>
        <mxCell id="c31" value="precision_at_k&#xa;recall_at_k" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#06b6d4;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="80" y="736" width="400" height="84" as="geometry"/></mxCell>
        <mxCell id="c32" value="Deterministic. Compares retrieved node_ids against the ground-truth citations. No LLM involved." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#06b6d4;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=top;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="80" y="820" width="400" height="116" as="geometry"/></mxCell>
        <mxCell id="c33" value="ANSWER QUALITY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a855f7;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="688" width="400" height="48" as="geometry"/></mxCell>
        <mxCell id="c34" value="judge score 1–10&#xa;token_f1 · exact_match&#xa;citation_audit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a855f7;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="520" y="736" width="400" height="84" as="geometry"/></mxCell>
        <mxCell id="c35" value="The citation audit catches coincidental correctness — a right answer produced from model memory rather than retrieval." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a855f7;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=top;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="520" y="820" width="400" height="116" as="geometry"/></mxCell>
        <mxCell id="c36" value="EFFICIENCY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="688" width="400" height="48" as="geometry"/></mxCell>
        <mxCell id="c37" value="latency_sec&#xa;input_tokens · output_tokens" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="960" y="736" width="400" height="84" as="geometry"/></mxCell>
        <mxCell id="c38" value="Cost per query. A pipeline that wins on quality but is far slower is a different recommendation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=top;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="960" y="820" width="400" height="116" as="geometry"/></mxCell>
        <mxCell id="c39" value="WHY THE GATE RUNS FIRST — an unvalidated judge makes every downstream number unfalsifiable. Sixty outputs are cheap to&#xa;check by hand; nine hundred are not. Calibrating after the expensive run would leave nothing to compare against." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=18;spacingRight=18;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="80" y="980" width="1280" height="76" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
