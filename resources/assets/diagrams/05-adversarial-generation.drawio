<mxfile host="app.diagrams.net" type="device">
  <diagram id="05-adversarial-generation.drawio" name="Adversarial Dataset Generation">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="Adversarial Dataset Generation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#6366f1;fontSize=24;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="44" width="1200" height="34" as="geometry"/></mxCell>
        <mxCell id="t2" value="Two model families, opposed roles. Nothing enters the benchmark on a single model&#x27;s word." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="1200" height="22" as="geometry"/></mxCell>
        <mxCell id="c3" value="SEC 10-K SECTION CHUNK&#xa;split per filing section, sized under the provider token ceiling" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f43f5e;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="140" width="560" height="76" as="geometry"/></mxCell>
        <mxCell id="c4" value="GENERATOR&#xa;nvidia/nemotron-3-super-120b-a12b:free  ·  OpenRouter&#xa;writes question · answer · node_id citations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6366f1;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="266" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="c5" value="CANDIDATE RECORD&#xa;question · expected answer · cited node_ids · quadrant label" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f59e0b;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="426" width="560" height="76" as="geometry"/></mxCell>
        <mxCell id="c6" value="CRITIC&#xa;openai/gpt-oss-20b:free  ·  OpenRouter  ·  different family&#xa;re-derives the answer independently, with a search tool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d946ef;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="552" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="c7" value="CROSS-CHECK&#xa;Critic&#x27;s answer and citations compared against the Generator&#x27;s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#06b6d4;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="712" width="560" height="76" as="geometry"/></mxCell>
        <mxCell id="c8" value="ACCEPTED INTO THE POOL&#xa;written to SQLite, assigned to PQ / GQ / JEQ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#22c55e;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=center;shadow=0;glass=0;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="838" width="560" height="76" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#f43f5e;strokeWidth=2;endArrow=block;endFill=1;shadow=0;fontColor=#f43f5e;fontSize=11;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;labelBackgroundColor=none;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6366f1;strokeWidth=2;endArrow=block;endFill=1;shadow=0;fontColor=#6366f1;fontSize=11;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;labelBackgroundColor=none;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#f59e0b;strokeWidth=2;endArrow=block;endFill=1;shadow=0;fontColor=#f59e0b;fontSize=11;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;labelBackgroundColor=none;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d946ef;strokeWidth=2;endArrow=block;endFill=1;shadow=0;fontColor=#d946ef;fontSize=11;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;labelBackgroundColor=none;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="agree" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#06b6d4;strokeWidth=2;endArrow=block;endFill=1;shadow=0;fontColor=#06b6d4;fontSize=11;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;labelBackgroundColor=none;jettySize=auto;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry x="-0.1792" y="30" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e14" value="disagree — discard and regenerate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ef4444;strokeWidth=2;endArrow=block;endFill=1;shadow=0;fontColor=#ef4444;fontSize=11;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;labelBackgroundColor=none;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=4 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c4"><mxGeometry x="0.0023" y="112" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="t15" value="WHY TWO MODELS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="270" width="300" height="24" as="geometry"/></mxCell>
        <mxCell id="c16" value="A single model writing and then approving its own questions is both author and validator of the benchmark.&#xa;&#xa;The Critic breaks that circularity before the data is ever used." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="t17" value="SEARCH TOOL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="560" width="300" height="24" as="geometry"/></mxCell>
        <mxCell id="c18" value="The Critic re-locates the evidence itself rather than trusting the Generator&#x27;s citations, so a wrong node_id fails the cross-check." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#14b8a6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="80" y="590" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="t19" value="TEMPERATURE = 0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="270" width="300" height="24" as="geometry"/></mxCell>
        <mxCell id="c20" value="Both stages run deterministically, so the whole protocol can be re-executed and audited by a third party." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="1060" y="300" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="t21" value="DATASET COMPLETE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#22c55e;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="560" width="300" height="24" as="geometry"/></mxCell>
        <mxCell id="c22" value="PQ   100 / 100&#xa;GQ    20 / 20&#xa;JEQ   20 / 20&#xa;&#xa;140 of 140 rows" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#22c55e;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="590" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c23" value="THE SAME PRINCIPLE APPLIES DOWNSTREAM — the Answerer (Llama) and the Judge (Qwen) are also drawn from different&#xa;model families. No model in this project ever grades output produced by its own family." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=18;spacingRight=18;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="80" y="960" width="1280" height="88" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
