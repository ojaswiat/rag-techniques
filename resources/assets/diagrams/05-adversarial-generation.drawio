        <mxCell id="t15" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" value="WHY TWO MODELS" vertex="1">
          <mxGeometry height="24" width="300" x="80" y="270" as="geometry" />
        </mxCell>
        <mxCell id="c16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#8b5cf6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" value="A single model writing and then approving its own questions is both author and validator of the benchmark.&#xa;&#xa;The Critic breaks that circularity before the data is ever used." vertex="1">
          <mxGeometry height="150" width="300" x="80" y="300" as="geometry" />
        </mxCell>
        <mxCell id="t17" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#64748b;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;shadow=0;fontStyle=1;" value="SEARCH TOOL" vertex="1">
          <mxGeometry height="24" width="300" x="80" y="560" as="geometry" />
        </mxCell>
        <mxCell id="c18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#14b8a6;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;arcSize=0;" value="The Critic re-locates the evidence itself rather than trusting the Generator&#39;s citations, so a wrong node_id fails the cross-check." vertex="1">
          <mxGeometry height="130" width="300" x="80" y="590" as="geometry" />
        </mxCell>
