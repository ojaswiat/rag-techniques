        <mxCell id="c19" value="DISJOINTNESS IS LOAD-BEARING — a question used to calibrate the judge can never be used to test it, and neither can&#xa;ever be used to benchmark the pipelines. Enforced in code and asserted by the test suite on every run." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=none;fontColor=#FFFFFF;fontSize=13;fontFamily=Inter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DInter;verticalAlign=middle;align=left;shadow=0;glass=0;spacingLeft=18;spacingRight=18;spacingTop=6;spacingBottom=6;arcSize=0;" vertex="1" parent="1"><mxGeometry x="80" y="650" width="1240" height="80" as="geometry"/></mxCell>
